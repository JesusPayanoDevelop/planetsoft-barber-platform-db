/* ============================================================
   F) APPOINTMENTS (reservas tipo Hostelworld) + lines
   ============================================================ */

IF OBJECT_ID('dbo.appointments','U') IS NULL
BEGIN
  CREATE TABLE dbo.appointments (
    appointment_id    UNIQUEIDENTIFIER NOT NULL CONSTRAINT DF_appt_id DEFAULT NEWSEQUENTIALID(),
    tenant_id         UNIQUEIDENTIFIER NOT NULL,
    branch_id         UNIQUEIDENTIFIER NULL,

    customer_user_id  UNIQUEIDENTIFIER NOT NULL,  -- quien reserva
    staff_user_id     UNIQUEIDENTIFIER NULL,      -- quien atiende (opcional)

    status            VARCHAR(20) NOT NULL,       -- PENDING|CONFIRMED|CANCELLED|COMPLETED
    starts_at         DATETIME2(3) NOT NULL,
    ends_at           DATETIME2(3) NOT NULL,

    currency_code     CHAR(3) NOT NULL,
    service_amount    DECIMAL(18,2) NOT NULL,     -- total servicio
    deposit_amount    DECIMAL(18,2) NOT NULL CONSTRAINT DF_appt_deposit DEFAULT 0, -- pago inicial
    notes             NVARCHAR(1000) NULL,

    created_at        DATETIME2(3) NOT NULL CONSTRAINT DF_appt_created DEFAULT SYSUTCDATETIME(),
    updated_at        DATETIME2(3) NOT NULL CONSTRAINT DF_appt_updated DEFAULT SYSUTCDATETIME(),
    row_version       ROWVERSION NOT NULL,

    CONSTRAINT PK_appointments PRIMARY KEY (appointment_id),
    CONSTRAINT FK_appt_tenant FOREIGN KEY (tenant_id) REFERENCES dbo.tenants(tenant_id),
    CONSTRAINT FK_appt_branch FOREIGN KEY (branch_id) REFERENCES dbo.branches(branch_id),
    CONSTRAINT FK_appt_customer FOREIGN KEY (customer_user_id) REFERENCES dbo.users(user_id),
    CONSTRAINT FK_appt_staff FOREIGN KEY (staff_user_id) REFERENCES dbo.users(user_id),
    CONSTRAINT CK_appt_status CHECK (status IN ('PENDING','CONFIRMED','CANCELLED','COMPLETED')),
    CONSTRAINT CK_appt_time CHECK (ends_at > starts_at),
    CONSTRAINT CK_appt_amounts CHECK (service_amount >= 0 AND deposit_amount >= 0 AND deposit_amount <= service_amount)
  );

  CREATE INDEX IX_appt_tenant_starts ON dbo.appointments(tenant_id, starts_at);
  CREATE INDEX IX_appt_customer_starts ON dbo.appointments(customer_user_id, starts_at);
END;

IF OBJECT_ID('dbo.appointment_lines','U') IS NULL
BEGIN
  CREATE TABLE dbo.appointment_lines (
    appointment_line_id UNIQUEIDENTIFIER NOT NULL CONSTRAINT DF_appt_line_id DEFAULT NEWSEQUENTIALID(),
    appointment_id      UNIQUEIDENTIFIER NOT NULL,
    catalog_item_id     UNIQUEIDENTIFIER NOT NULL, -- SERVICE
    qty                INT NOT NULL CONSTRAINT DF_appt_qty DEFAULT 1,
    unit_price         DECIMAL(18,2) NOT NULL,

    line_total AS (CONVERT(DECIMAL(18,2), qty * unit_price)) PERSISTED,

    CONSTRAINT PK_appointment_lines PRIMARY KEY (appointment_line_id),
    CONSTRAINT FK_appt_line_appt FOREIGN KEY (appointment_id) REFERENCES dbo.appointments(appointment_id),
    CONSTRAINT FK_appt_line_item FOREIGN KEY (catalog_item_id) REFERENCES dbo.tenant_catalog_items(catalog_item_id),
    CONSTRAINT CK_appt_line_qty CHECK (qty > 0),
    CONSTRAINT CK_appt_line_price CHECK (unit_price >= 0)
  );

  CREATE INDEX IX_appt_lines_appt ON dbo.appointment_lines(appointment_id);
END;


/* ============================================================
   G) ORDERS (venta de productos) + lines
