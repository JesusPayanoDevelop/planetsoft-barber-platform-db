/* ============================================================
   PLANETSOFT - PRO HARDENING PATCH (SQL Server / DBeaver)
   - SIN GO
   - 100% idempotente (solo agrega si falta)
   - Evita "Invalid column name" usando SQL dinámico cuando corresponde
   - No rompe tu modelo actual
   ============================================================ */

SET NOCOUNT ON;

PRINT '=== PlanetSoft PRO Hardening Patch: START ===';

------------------------------------------------------------
-- 0) Helpers: crea índices sólo si no existen (con EXEC)
------------------------------------------------------------

/* ============================================================
   1) SOFT DELETE (opcional pero MUY pro)
   - agrega is_deleted + deleted_at en tablas core
   ============================================================ */
DECLARE @sql NVARCHAR(MAX);

-- Lista de tablas a endurecer con soft delete (ajusta si quieres)
DECLARE @SoftDelete TABLE (table_name SYSNAME);
INSERT INTO @SoftDelete(table_name)
VALUES
('users'),
('tenants'),
('branches'),
('tenant_catalog_items'),
('tenant_catalog_categories'),
('orders'),
('order_lines'),
('payments'),
('appointments'),
('appointment_lines');

DECLARE @t SYSNAME;

DECLARE cur_sd CURSOR LOCAL FAST_FORWARD FOR
SELECT table_name FROM @SoftDelete;

OPEN cur_sd;
FETCH NEXT FROM cur_sd INTO @t;

WHILE @@FETCH_STATUS = 0
BEGIN
  IF OBJECT_ID(CONCAT('dbo.', @t), 'U') IS NOT NULL
  BEGIN
    IF COL_LENGTH(CONCAT('dbo.', @t), 'is_deleted') IS NULL
    BEGIN
      SET @sql = CONCAT('ALTER TABLE dbo.', @t, ' ADD is_deleted BIT NOT NULL CONSTRAINT DF_', @t, '_is_deleted DEFAULT 0;');
      EXEC(@sql);
    END;

    IF COL_LENGTH(CONCAT('dbo.', @t), 'deleted_at') IS NULL
    BEGIN
      SET @sql = CONCAT('ALTER TABLE dbo.', @t, ' ADD deleted_at DATETIME2(3) NULL;');
      EXEC(@sql);
    END;

    -- Índice filtrado para queries “activos”
    IF NOT EXISTS (
      SELECT 1 FROM sys.indexes
      WHERE name = CONCAT('IX_', @t, '_not_deleted')
        AND object_id = OBJECT_ID(CONCAT('dbo.', @t))
    )
    BEGIN
      -- Solo si existe is_deleted
      IF COL_LENGTH(CONCAT('dbo.', @t), 'is_deleted') IS NOT NULL
      BEGIN
        SET @sql = CONCAT('CREATE INDEX IX_', @t, '_not_deleted ON dbo.', @t, '(is_deleted) WHERE is_deleted = 0;');
        EXEC(@sql);
      END
    END
  END

  FETCH NEXT FROM cur_sd INTO @t;
END

CLOSE cur_sd;
DEALLOCATE cur_sd;


