IF OBJECT_ID('dbo.tenant_catalog_categories','U') IS NULL
BEGIN
  CREATE TABLE dbo.tenant_catalog_categories (
    category_id    UNIQUEIDENTIFIER NOT NULL CONSTRAINT DF_cat_id DEFAULT NEWSEQUENTIALID(),
    tenant_id      UNIQUEIDENTIFIER NOT NULL,
    category_code  VARCHAR(40) NOT NULL,
    name           NVARCHAR(120) NOT NULL,
    sort_order     INT NOT NULL CONSTRAINT DF_cat_sort DEFAULT 0,
    is_active      BIT NOT NULL CONSTRAINT DF_cat_active DEFAULT 1,
    created_at     DATETIME2(3) NOT NULL CONSTRAINT DF_cat_created DEFAULT SYSUTCDATETIME(),

    CONSTRAINT PK_tenant_catalog_categories PRIMARY KEY (category_id),
    CONSTRAINT FK_cat_tenant FOREIGN KEY (tenant_id) REFERENCES dbo.tenants(tenant_id),
    CONSTRAINT UQ_cat_tenant_code UNIQUE (tenant_id, category_code)
  );

  CREATE INDEX IX_cat_tenant_active ON dbo.tenant_catalog_categories(tenant_id, is_active);
END;

IF OBJECT_ID('dbo.tenant_catalog_items','U') IS NULL
BEGIN
  CREATE TABLE dbo.tenant_catalog_items (
    catalog_item_id   UNIQUEIDENTIFIER NOT NULL CONSTRAINT DF_item_id DEFAULT NEWSEQUENTIALID(),
    tenant_id         UNIQUEIDENTIFIER NOT NULL,
    branch_id         UNIQUEIDENTIFIER NULL, -- NULL = aplica a todo el tenant
    category_id       UNIQUEIDENTIFIER NULL,

    item_type         VARCHAR(20) NOT NULL,  -- SERVICE|PRODUCT
    sku               VARCHAR(50) NULL,      -- solo PRODUCT
    name              NVARCHAR(150) NOT NULL,
    description       NVARCHAR(1000) NULL,

    currency_code     CHAR(3) NOT NULL,
    base_price        DECIMAL(18,2) NOT NULL,
    duration_minutes  INT NULL,              -- para SERVICE

    is_active         BIT NOT NULL CONSTRAINT DF_item_active DEFAULT 1,
    created_at        DATETIME2(3) NOT NULL CONSTRAINT DF_item_created DEFAULT SYSUTCDATETIME(),
    updated_at        DATETIME2(3) NOT NULL CONSTRAINT DF_item_updated DEFAULT SYSUTCDATETIME(),
    row_version       ROWVERSION NOT NULL,

    CONSTRAINT PK_tenant_catalog_items PRIMARY KEY (catalog_item_id),
    CONSTRAINT FK_item_tenant FOREIGN KEY (tenant_id) REFERENCES dbo.tenants(tenant_id),
    CONSTRAINT FK_item_branch FOREIGN KEY (branch_id) REFERENCES dbo.branches(branch_id),
    CONSTRAINT FK_item_category FOREIGN KEY (category_id) REFERENCES dbo.tenant_catalog_categories(category_id),
    CONSTRAINT CK_item_type CHECK (item_type IN ('SERVICE','PRODUCT')),
    CONSTRAINT CK_item_price CHECK (base_price >= 0),
    CONSTRAINT CK_item_duration CHECK (duration_minutes IS NULL OR duration_minutes > 0)
  );

  CREATE INDEX IX_items_tenant_type_active ON dbo.tenant_catalog_items(tenant_id, item_type, is_active);
  CREATE INDEX IX_items_tenant_branch ON dbo.tenant_catalog_items(tenant_id, branch_id);
END;

IF OBJECT_ID('dbo.catalog_item_media','U') IS NULL
BEGIN
  CREATE TABLE dbo.catalog_item_media (
    catalog_item_id  UNIQUEIDENTIFIER NOT NULL,
    media_id         UNIQUEIDENTIFIER NOT NULL,
    is_primary       BIT NOT NULL CONSTRAINT DF_cim_primary DEFAULT 0,
    sort_order       INT NOT NULL CONSTRAINT DF_cim_sort DEFAULT 0,

    CONSTRAINT PK_catalog_item_media PRIMARY KEY (catalog_item_id, media_id),
    CONSTRAINT FK_cim_item FOREIGN KEY (catalog_item_id) REFERENCES dbo.tenant_catalog_items(catalog_item_id),
    CONSTRAINT FK_cim_media FOREIGN KEY (media_id) REFERENCES dbo.media_assets(media_id)
  );

  CREATE INDEX IX_cim_media ON dbo.catalog_item_media(media_id);
END;


/* ============================================================
   E) INVENTORY (solo PRODUCT) + uniqueness por tenant/branch/item
   ============================================================ */

IF OBJECT_ID('dbo.inventory_items','U') IS NULL
BEGIN
  CREATE TABLE dbo.inventory_items (
    inventory_item_id UNIQUEIDENTIFIER NOT NULL CONSTRAINT DF_inv_id DEFAULT NEWSEQUENTIALID(),
    tenant_id         UNIQUEIDENTIFIER NOT NULL,
    branch_id         UNIQUEIDENTIFIER NULL,
    catalog_item_id   UNIQUEIDENTIFIER NOT NULL,

