    CONSTRAINT PK_orders PRIMARY KEY (order_id),
    CONSTRAINT FK_orders_tenant FOREIGN KEY (tenant_id) REFERENCES dbo.tenants(tenant_id),
    CONSTRAINT FK_orders_branch FOREIGN KEY (branch_id) REFERENCES dbo.branches(branch_id),
    CONSTRAINT FK_orders_customer FOREIGN KEY (customer_user_id) REFERENCES dbo.users(user_id),
    CONSTRAINT CK_orders_status CHECK (status IN ('PENDING','PAID','CANCELLED','FULFILLED')),
    CONSTRAINT CK_orders_amounts CHECK (subtotal_amount >= 0 AND total_amount >= 0 AND total_amount >= subtotal_amount)
